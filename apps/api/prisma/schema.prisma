// EduStore — кабинет учителя. Схема БД (PostgreSQL + Prisma).
// Мультитенантность (§3.6): organizationId на КАЖДОЙ доменной сущности (ключ тенанта).
// Изоляция принудительна на уровне приложения — tenant-guard (Prisma $use middleware,
// common/tenant): каждый запрос доменной модели фильтруется текущим тенантом из ALS.
// RLS на БД — следующий слой усиления (защита от забытого фильтра в новом коде).
// Границы доменов: связи по id; межмодульных жёстких зависимостей в запросах избегаем.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────
enum LessonType {
  LESSON
  TEST
  CONTROL
}

enum GradeSource {
  MANUAL
  VOICE
}

enum MaterialType {
  LESSON_PLAN
  GRAPHIC_NOTES
  PRESENTATION
  TEST
  CONTROL
  BRIEF_TEST
}

enum NotificationType {
  URGENT
  NORMAL
  INFO
}

// ─────────────────────────── identity ───────────────────────────
// Пользователь принадлежит платформе (florus_user_id), организация приглашает его.
model User {
  id          String    @id // = florus_user_id
  firstName   String
  lastName    String
  displayName String
  email       String?
  teacher     Teacher?
  createdAt   DateTime  @default(now())
}

model Organization {
  id          String       @id @default(cuid())
  florusOrgId String?      @unique // зеркало org_id из Флёруса (lazy-provision при первом входе)
  status      String       @default("active") // pending | active
  name        String
  type        String       @default("School") // School | Studio | Specialist | Union
  classes     Class[]
  subjects    Subject[]
  memberships Membership[]
  devices     Device[]
  createdAt   DateTime     @default(now())
}

// Членство пользователя в организации + EduStore-роль. florusRole из Флёруса;
// subRole (staff → завуч|методист|психолог) назначает школьный админ (ADR-0005).
model Membership {
  id           String       @id @default(cuid())
  florusUserId String // = User.id (sub)
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  florusRole   String // owner | admin | teacher | staff | parent | student
  subRole      String? // zavuch | methodist | psychologist
  createdAt    DateTime     @default(now())

  @@unique([florusUserId, orgId])
}

// Серверная сессия RP (BFF): cookie flor_sid → эта запись. Токены — server-only.
model Session {
  sid          String   @id
  florusUserId String
  florusSid    String? // sid сессии Флёруса (для back-channel logout)
  orgId        String?
  florusOrgId  String?
  role         String
  subRole      String?
  name         String
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  idToken      String?  @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([florusUserId])
  @@index([florusSid])
}

// Привязанное устройство-киоск (главная страница, режим «вход на школьном компьютере»).
// Регистрируется по QR через Device Authorization Flow (purpose=kiosk); deviceToken
// хранится в localStorage киоска и определяет показ экрана входа (режим 3).
model Device {
  id            String       @id @default(cuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  deviceToken   String       @unique
  boundByUserId String? // User.id того, кто подтвердил привязку с телефона
  lastSeenAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([orgId])
}

// ─────────────────────────── teacher ───────────────────────────
model Teacher {
  id             String               @id // = florus_user_id (FK → User)
  user           User                 @relation(fields: [id], references: [id], onDelete: Cascade)
  organizationId String
  isCurator      Boolean              @default(false)
  curatorClassId String?
  assignments    TeachingAssignment[]
  notes          TeacherNote[]
  notifications  Notification[]

  @@index([organizationId])
}

// Один «флажок»: учитель ведёт предмет в классе (опц. — в конкретной подгруппе).
model TeachingAssignment {
  id         String    @id @default(cuid())
  organizationId String // тенант (§3.6) = Class.organizationId
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId    String
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id])
  subGroupId String?
  subGroup   SubGroup? @relation(fields: [subGroupId], references: [id])

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([organizationId])
}

// ─────────────────────────── academic structure ───────────────────────────
model Subject {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  fgosDocUrl     String?
  textbookUrl    String?
  color          String               @default("#2563EB")
  departmentId   String?
  assignments    TeachingAssignment[]
  lessons        Lesson[]
}

model Class {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  parallel       Int
  letter         String
  label          String // "8А"
  students       Student[]
  subGroups      SubGroup[]
  lessons        Lesson[]
  assignments    TeachingAssignment[]

  @@index([organizationId])
}

model SubGroup {
  id          String               @id @default(cuid())
  organizationId String            // тенант (§3.6) = Class.organizationId
  classId     String
  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  members     Student[]
  assignments TeachingAssignment[]

  @@index([organizationId])
}

model Student {
  id          String          @id @default(cuid())
  organizationId String       // тенант (§3.6): денормализация ключа на дочерние для guard/RLS = Class.organizationId
  classId     String
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subGroupId  String?
  subGroup    SubGroup?       @relation(fields: [subGroupId], references: [id])
  number      Int
  firstName   String
  lastName    String
  displayName String // "Иванов Артём"
  grades      Grade[]
  profile     StudentProfile?
  notes       TeacherNote[]

  @@index([classId])
  @@index([organizationId])
}

// ─────────────────────────── lesson = станция метро ───────────────────────────
model Lesson {
  id           String              @id @default(cuid())
  organizationId String
  subjectId    String
  subject      Subject             @relation(fields: [subjectId], references: [id])
  classId      String
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  topic        String
  shortTitle   String
  unit         String? // "Глава 3 · Квадратные уравнения"
  goals        String[]
  lessonNumber Int
  date         DateTime
  type         LessonType          @default(LESSON)
  bloomLevel   Int?
  pageStart    Int?
  pageEnd      Int?
  homework     String?
  grades       Grade[]
  materials    GeneratedMaterial[]
  notes        TeacherNote[]

  @@index([classId, subjectId, date])
}

model Grade {
  id        String      @id @default(cuid())
  organizationId String  // тенант (§3.6) = Lesson.organizationId
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  value     Int? // 2..5, null если только посещаемость/комментарий
  absent    Boolean     @default(false)
  comment   String?
  createdBy String // teacherId
  source    GradeSource @default(MANUAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([organizationId])
}

// ─────────────────────────── materials / profile / notes ───────────────────────────
model GeneratedMaterial {
  id          String       @id @default(cuid())
  organizationId String     // тенант (§3.6) = Lesson.organizationId
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        MaterialType
  title       String
  fileUrl     String
  format      String // DOCX | PDF | PPTX
  meta        String? // "6 страниц"
  generatedAt DateTime     @default(now())

  @@index([organizationId])
}

model StudentProfile {
  studentId    String   @id
  organizationId String  // тенант (§3.6) = Student→Class.organizationId; профиль = ПДн ученика
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interests    String[]
  strengths    String[]
  weaknesses   String[]
  inclinations String[]
  updatedAt    DateTime @updatedAt

  @@index([organizationId])
}

model TeacherNote {
  note_id       String   @id @default(cuid()) @map("id")
  organizationId String  // тенант (§3.6) = Teacher.organizationId
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id])
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id])
  audioUrl      String?
  transcription String
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([teacherId])
  @@index([organizationId])
}

model Notification {
  id        String           @id @default(cuid())
  organizationId String       // тенант (§3.6) = Teacher.organizationId
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  type      NotificationType
  category  String // journal | ktp | ...
  title     String
  message   String
  icon      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([teacherId, read])
  @@index([organizationId])
}

// ═══════════════════════════ EVENT INFRASTRUCTURE (shared kernel) ═══════════════════════════
// Transactional outbox + idempotent inbox — основа каскадов между параметрами (см. docs/PARAMETERS.md §3).
enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED // = DLQ после исчерпания попыток
}

model OutboxEvent {
  id             String       @id // = DomainEvent.id (идемпотентный ключ / Nats-Msg-Id)
  type           String
  organizationId String
  correlationId  String // весь каскад
  causationId    String? // событие-причина
  depth          Int          @default(0) // защита от петель
  actor          String?
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())
  publishedAt    DateTime?

  @@index([status, createdAt])
  @@index([correlationId])
}

model ProcessedEvent {
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
}

// ═══════════════════════════ ПАРАМЕТРЫ (демо-каскад «зачисление ученика») ═══════════════════════════
model ChannelMembership {
  // Communitoria
  id             String   @id @default(cuid())
  organizationId String
  classId        String
  studentId      String
  createdAt      DateTime @default(now())

  @@unique([classId, studentId])
}

model MealOrder {
  // Питательный
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  status         String   @default("DEFAULT")
  createdAt      DateTime @default(now())
}

// ═══════════════════════════ AUTHZ: ПРАВА КАК ДАННЫЕ (§5.1) ═══════════════════════════
// Каталог прав Раздел→Экран→Действие + пакеты ролей. Резолв доступа = пакет роли × каталог
// (из БД, не из кода). Глобальная reference-data — НЕ под тенант-изоляцией (см. tenant-models).
model Permission {
  id       String                  @id @default(cuid())
  code     String                  @unique // "journal.grades.edit"
  section  String // "journal"
  screen   String // "grades"
  action   String // "edit" | "view" | "manage" | ...
  label    String
  packages RolePackagePermission[]
}

// Пакет роли: какой кабинет открывается и какие права даёт. key = роль/суб-роль EduStore.
model RolePackage {
  id          String                  @id @default(cuid())
  key         String                  @unique // owner|admin|teacher|parent|student|zavuch|methodist|psychologist
  cabinet     String // CabinetKey фронта
  label       String
  permissions RolePackagePermission[]
}

model RolePackagePermission {
  rolePackageId String
  rolePackage   RolePackage @relation(fields: [rolePackageId], references: [id], onDelete: Cascade)
  permissionId  String
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([rolePackageId, permissionId])
}

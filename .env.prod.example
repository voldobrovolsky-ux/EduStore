# EduStore production env (скопировать в .env.prod, не коммитить). См. docs/DEPLOY.md.
POSTGRES_USER=edustore
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=edustore

# ASR: 1 — мок без модели (демо); 0 — реальный faster-whisper
ASR_MOCK=0
ASR_MODEL=small

# Аутентификация: production → требуется сессия Флёруса (без dev-bypass)
AUTH_MODE=production

# Публичный origin (редирект после входа + ссылка в QR привязки устройства, режим 2 главной)
WEB_ORIGIN=https://edustore-flor-group.ru

# Флёрус (ADR-0005) — заполнить после регистрации клиента edustore
FLOR_ISSUER=https://accounts.flor-group.ru
FLOR_CLIENT_ID=edustore
FLOR_CLIENT_SECRET=
FLOR_REDIRECT_URI=https://edustore-flor-group.ru/api/auth/flor/callback
FLOR_POST_LOGOUT_REDIRECT_URI=https://edustore-flor-group.ru

# S3-совместимое хранилище (Yandex Object Storage/AWS/MinIO — один провайдер, разница в конфиге).
# Документохранилище + учебники методкопилки. Пусто → API поднимается, загрузка файлов отдаёт 503
# (не роняет остальной сервис) — заполнить перед реальным использованием методкопилки/файлов.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=edustore-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Ключ шифрования секретов настроек воркспейса (apiKey LLM-парсера учебников, AES-256-GCM).
# ОБЯЗАТЕЛЕН в проде — без него используется небезопасный dev-дефолт. Сгенерировать:
#   openssl rand -base64 32
SETTINGS_ENC_KEY=
